{
  "manifest_version": 3,
  "name": "TerminalVibes",
  "version": "1.0.0",
  "description": "Real-time music generated from your coding activity.",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*",
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}